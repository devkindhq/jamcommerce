generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model donors {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  name       String?
  email      String?   @unique @db.VarChar
  anonymous  Boolean
}

model charges {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  stripe_id       String?
  amount          Decimal?  @db.Decimal
  amount_captured Decimal?  @db.Decimal
  billing_details Json?     @db.Json
  paid            Boolean?
  refunded        Boolean?
  metadata        Json?     @db.Json
}

model checkout_sessions {
  id                         BigInt    @id @default(autoincrement())
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)
  status                     String?   @db.VarChar
  payment_status             String?   @db.VarChar
  currency                   String?   @db.VarChar
  amount_total               Decimal?  @db.Decimal
  customer_details           Json?     @db.Json
  line_items                 Json?     @db.Json
  metadata                   Json?     @db.Json
  stripe_id                  String
  base_currency              String    @db.VarChar
  base_currency_amount_total Decimal   @db.Decimal
}

model currency_rates {
  id         BigInt    @id @default(autoincrement())
  code       String?   @db.VarChar
  value      Decimal?  @db.Decimal
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  currency   String?   @db.VarChar
  status     Boolean?
}

model campaigns {
  id           BigInt    @id @default(autoincrement())
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  user_id      String    @db.VarChar
  slug         String    @unique @db.VarChar
  title        String    @db.VarChar
  description  String?
  goal_amount  Decimal   @db.Decimal
  currency     String    @db.VarChar @default("AUD")
  end_date     DateTime? @db.Timestamptz(6)
  status       String    @db.VarChar @default("active")
  banner_url   String?   @db.VarChar
}

model waitlist {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  email      String    @unique @db.VarChar
}
